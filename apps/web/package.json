{
  "name": "evs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "gen:api": "openapi-typescript ../../packages/contract/openapi.json -o src/api/schema.d.ts",
    "postinstall": "node scripts/copy-uswds-assets.mjs",
    "dev:mock": "VITE_MOCK=1 vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "a11y:pa11y": "node scripts/run-pa11y.cjs",
    "a11y:lhci": "lhci autorun --config=lighthouserc.cjs",
    "a11y:urls": "node scripts/a11y-urls.cjs",
    "a11y:all": "pnpm test:a11y && pnpm a11y:pa11y && pnpm a11y:lhci"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.0",
    "@trussworks/react-uswds": "^12.0.0",
    "@uswds/uswds": "^3.13.0",
    "echarts": "^5.6.0",
    "maplibre-gl": "^5.6.0",
    "openapi-fetch": "^0.13.0",
    "pmtiles": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.30.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.54.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^3.2.7",
    "axe-core": "^4.13.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "openapi-typescript": "^7.8.0",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.63.0",
    "sass": "^1.89.0",
    "storybook": "^9.1.20",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
