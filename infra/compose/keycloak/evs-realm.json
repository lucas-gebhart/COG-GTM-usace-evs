{
  "realm": "evs",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "evs_viewer", "description": "Read dashboards (APEX: Authenticated User scheme)"},
      {"name": "evs_pm", "description": "Project managers (APEX: Contributor scheme)"},
      {"name": "evs_admin", "description": "Feed thresholds and admin (APEX: Administrator scheme)"}
    ]
  },
  "clients": [
    {
      "clientId": "evs-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*", "https://usace-evs-web.fly.dev/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173", "https://usace-evs-web.fly.dev"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "users": [
    {"username": "demo.viewer", "enabled": true, "firstName": "Dana", "lastName": "Viewer", "email": "viewer@example.mil",
     "credentials": [{"type": "password", "value": "demo", "temporary": false}], "realmRoles": ["evs_viewer"]},
    {"username": "demo.pm", "enabled": true, "firstName": "Pat", "lastName": "Manager", "email": "pm@example.mil",
     "credentials": [{"type": "password", "value": "demo", "temporary": false}], "realmRoles": ["evs_viewer", "evs_pm"]},
    {"username": "demo.admin", "enabled": true, "firstName": "Alex", "lastName": "Admin", "email": "admin@example.mil",
     "credentials": [{"type": "password", "value": "demo", "temporary": false}], "realmRoles": ["evs_viewer", "evs_pm", "evs_admin"]}
  ]
}
